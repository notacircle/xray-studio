{
  "name": "xray-studio",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "Desktop tool for testing Xray-core configs: live balancer decision tracing and realistic per-outbound fault injection",
  "scripts": {
    "bootstrap": "scripts/bootstrap-xray.sh",
    "check-pin": "scripts/check-pin.sh",
    "build:sidecar": "node scripts/ensure-sidecar.mjs",
    "test:sidecar": "go -C sidecar test ./...",
    "dev": "scripts/dev.sh",
    "install:app": "npm --prefix app install",
    "package": "scripts/package.sh",
    "icon": "scripts/make-icon.sh",
    "test:app": "npm --prefix app run test",
    "package:all": "scripts/package.sh all"
  },
  "engines": {
    "node": ">=22"
  },
  "productName": "Xray Studio",
  "license": "MPL-2.0",
  "homepage": "https://github.com/NotACircle/xray-studio",
  "author": {
    "name": "NotACircle",
    "email": "notacircle@protonmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NotACircle/xray-studio.git"
  }
}
